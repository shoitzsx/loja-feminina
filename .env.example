# Database
DATABASE_URL="postgresql://user:password@localhost:5432/barbs_closet?schema=public"

# Auth and security
AUTH_SECRET="generate-a-long-random-secret"
SESSION_COOKIE_NAME="barbs_session"
# Development uses localhost. In Vercel production, set this to the live domain,
# for example: https://lojafeminina-jdb2xmxsl-lucasizaias.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Payment gateway adapter
PAYMENT_PROVIDER="mock"
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# Shipping and CEP
CEP_PROVIDER="viacep"
SHIPPING_API_KEY=""

# Email
EMAIL_PROVIDER="mock"
EMAIL_API_KEY=""
ADMIN_EMAIL="admin@barbscloset.com.br"

# WhatsApp Business API
NEXT_PUBLIC_WHATSAPP_NUMBER="5599999999999"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
ADMIN_WHATSAPP_NUMBER="5599999999999"

# Fiscal provider
FISCAL_PROVIDER="pending"
FISCAL_API_KEY=""
FISCAL_WEBHOOK_SECRET=""

# Storage compatible with S3
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
