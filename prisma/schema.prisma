// Espelha as tabelas criadas em supabase/migrations/ (fonte da verdade do banco).
// O Prisma NÃO cria nem altera tabelas aqui: as migrações são o SQL versionado, com RLS.
// O servidor conecta com o papel `closet_app` (privilégio mínimo) pela DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED

  @@map("order_status")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELED
  REFUNDED

  @@map("payment_status")
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD

  @@map("payment_method")
}

model Order {
  id                    String      @id @default(uuid()) @db.Uuid
  orderNumber           String      @unique @map("order_number")
  userId                String?     @map("user_id") @db.Uuid
  guestTokenHash        String?     @map("guest_token_hash")
  customerName          String      @map("customer_name")
  customerEmail         String      @map("customer_email")
  customerPhoneEncrypted String?    @map("customer_phone_encrypted")
  shippingAddress       Json?       @map("shipping_address")
  status                OrderStatus @default(PENDING_PAYMENT)
  subtotalCents         Int         @map("subtotal_cents")
  discountCents         Int         @default(0) @map("discount_cents")
  shippingCents         Int         @default(0) @map("shipping_cents")
  totalCents            Int         @map("total_cents")
  shippingMethod        String?     @map("shipping_method")
  anonymizedAt          DateTime?   @map("anonymized_at") @db.Timestamptz(6)
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  paidAt                DateTime?   @map("paid_at") @db.Timestamptz(6)
  items                 OrderItem[]
  payments              Payment[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  productSlug    String @map("product_slug")
  productName    String @map("product_name")
  sku            String
  size           String?
  color          String?
  quantity       Int
  unitPriceCents Int    @map("unit_price_cents")
  totalCents     Int    @map("total_cents")
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  orderId      String        @map("order_id") @db.Uuid
  method       PaymentMethod
  status       PaymentStatus @default(PENDING)
  provider     String
  providerRef  String?       @map("provider_ref")
  amountCents  Int           @map("amount_cents")
  installments Int?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  paidAt       DateTime?     @map("paid_at") @db.Timestamptz(6)
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model WebhookEvent {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  eventId    String   @map("event_id")
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@map("webhook_events")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("audit_log")
}
