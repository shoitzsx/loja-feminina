generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
}

enum InvoiceStatus {
  PENDING
  REQUESTED
  ISSUED
  FAILED
  CANCELED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  SYSTEM
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id                String      @id @default(uuid()) @db.Uuid
  name              String
  email             String      @unique
  phone             String?
  passwordHash      String
  role              UserRole    @default(CUSTOMER)
  emailVerifiedAt   DateTime?
  failedLoginCount  Int         @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  addresses         Address[]
  carts             Cart[]
  orders            Order[]
  favorites         Favorite[]
  reviews           Review[]
  auditLogs         AuditLog[]
}

model Address {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  label        String?
  firstName    String
  lastName     String
  cpf          String?
  phone        String
  zipCode      String
  street       String
  number       String
  complement   String?
  district     String
  city         String
  state        String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([userId])
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  isActive    Boolean    @default(true)
  parentId    String?    @db.Uuid
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id               String           @id @default(uuid()) @db.Uuid
  categoryId       String           @db.Uuid
  name             String
  slug             String           @unique
  sku              String           @unique
  description      String
  careInstructions String?
  material         String?
  color            String?
  collection       String?
  priceCents       Int
  salePriceCents   Int?
  isActive         Boolean          @default(true)
  isFeatured       Boolean          @default(false)
  isNew            Boolean          @default(false)
  salesLast7Days   Int              @default(0)
  ratingAverage    Decimal          @default(0)
  ratingCount      Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  category         Category         @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  variants         ProductVariant[]
  favorites        Favorite[]
  reviews          Review[]
  orderItems       OrderItem[]
  cartItems        CartItem[]
  sizeCharts       SizeChart[]

  @@index([categoryId])
  @@index([slug])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String
  alt       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id          String      @id @default(uuid()) @db.Uuid
  productId   String      @db.Uuid
  sku         String      @unique
  size        String?
  color       String?
  material    String?
  weightGrams Int?
  dimensions  String?
  isActive    Boolean     @default(true)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory   Inventory?
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([productId])
}

model Inventory {
  id             String         @id @default(uuid()) @db.Uuid
  variantId      String         @unique @db.Uuid
  quantity       Int            @default(0)
  reserved       Int            @default(0)
  lowStockAlert  Int            @default(3)
  updatedAt      DateTime       @updatedAt
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String?    @db.Uuid
  sessionId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @db.Uuid
  productId String         @db.Uuid
  variantId String         @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model Order {
  id                  String      @id @default(uuid()) @db.Uuid
  orderNumber         String      @unique
  userId              String?     @db.Uuid
  addressId           String?     @db.Uuid
  customerName        String
  customerEmail       String
  customerPhone       String
  status              OrderStatus @default(PENDING_PAYMENT)
  subtotalCents       Int
  discountCents       Int         @default(0)
  shippingCents       Int         @default(0)
  totalCents          Int
  shippingMethod      String?
  shippingEstimate    String?
  couponCode          String?
  paymentGatewayRef   String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  paidAt              DateTime?
  user                User?       @relation(fields: [userId], references: [id])
  address             Address?    @relation(fields: [addressId], references: [id])
  items               OrderItem[]
  payments            Payment[]
  invoices            Invoice[]
  notifications       Notification[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @db.Uuid
  productId      String         @db.Uuid
  variantId      String         @db.Uuid
  productName    String
  sku            String
  size           String?
  color          String?
  quantity       Int
  unitPriceCents Int
  totalCents     Int
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
  variant        ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @db.Uuid
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  provider        String
  providerRef     String?
  tokenizedRef    String?
  amountCents     Int
  installments    Int?
  webhookPayload  Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paidAt          DateTime?
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerRef])
}

model Coupon {
  id                String   @id @default(uuid()) @db.Uuid
  code              String   @unique
  description       String?
  amountCents       Int?
  percentOff        Int?
  startsAt          DateTime?
  expiresAt         DateTime?
  usageLimit        Int?
  usedCount         Int      @default(0)
  minSubtotalCents  Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  rating    Int
  title     String?
  comment   String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @db.Uuid
  status        InvoiceStatus @default(PENDING)
  provider      String?
  externalRef   String?
  number        String?
  accessKey     String?
  documentUrl   String?
  errorMessage  String?
  requestedAt   DateTime?
  issuedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Notification {
  id           String              @id @default(uuid()) @db.Uuid
  orderId      String?             @db.Uuid
  channel      NotificationChannel
  status       NotificationStatus  @default(PENDING)
  recipient    String
  subject      String?
  payload      Json
  providerRef  String?
  errorMessage String?
  createdAt    DateTime            @default(now())
  sentAt       DateTime?
  order        Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
}

model Banner {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  subtitle    String?
  imageUrl    String
  ctaLabel    String
  ctaHref     String
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SizeChart {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String?  @db.Uuid
  size        String
  bustCm      Int?
  waistCm     Int?
  hipCm       Int?
  lengthCm    Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}
